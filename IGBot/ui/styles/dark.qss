* {
    color: #F4F7FA;
    font-family: "Segoe UI";
    font-size: 14px;
}

QMainWindow,
QWidget#devicesPage,
QWidget#phoneAccountsPage,
QWidget#accountPage,
QWidget#activityLogPage,
QWidget#globalSettingsPage,
QWidget#templatesPage,
QStackedWidget {
    background-color: #11161C;
}

QListWidget#configurationList {
    background-color: #0b1016;
    border: 1px solid #28323e;
    border-radius: 6px;
    color: #cbd4df;
    outline: 0;
    padding: 4px;
    selection-background-color: #173b66;
    selection-color: #f3f7fb;
}

QListWidget#configurationList::item {
    border-bottom: 1px solid #1c242e;
    min-height: 38px;
    padding: 0 10px;
}

QListWidget#configurationList::item:selected {
    background-color: #173b66;
    color: #f3f7fb;
}

QWidget#navigationSidebar {
    background-color: #181F27;
    border-right: 1px solid #2C3643;
}

QLabel#brandLabel {
    color: #f2f5f8;
    font-size: 21px;
    font-weight: 700;
    padding: 0 7px;
}

QLabel#brandCaption {
    color: #9AA7B3;
    font-size: 11px;
    font-weight: 500;
    padding: 0 7px;
}

QLabel#navigationSection {
    color: #687585;
    font-size: 10px;
    font-weight: 700;
    padding: 0 8px;
}

QListWidget#navigationList {
    background: transparent;
    border: 0;
    outline: 0;
}

QListWidget#navigationList::item {
    color: #9ba8b7;
    border-radius: 6px;
    min-height: 36px;
    padding: 0 10px;
    margin-bottom: 3px;
}

QListWidget#navigationList::item:selected {
    background-color: #173b66;
    color: #F9FAFB;
}

QToolBar#topToolbar {
    background-color: #181F27;
    border: 0;
    border-bottom: 1px solid #27303b;
    padding: 6px 12px;
    spacing: 6px;
}

QToolBar#topToolbar QToolButton {
    background-color: transparent;
    border: 1px solid #303a47;
    border-radius: 5px;
    color: #c8d1dc;
    min-height: 27px;
    padding: 0 8px;
}

QToolBar#topToolbar QToolButton:disabled {
    background-color: #1c242d;
    border-color: #303a46;
    color: #8290a0;
}

QToolBar#topToolbar QToolButton:pressed {
    background-color: #202b37;
    border-color: #526274;
}

QLabel#toolbarTitle {
    color: #e8edf3;
    font-size: 13px;
    font-weight: 600;
}

QWidget#pageHeader { background: transparent; }

QLabel#pageTitle {
    color: #f2f5f8;
    font-size: 22px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #788697;
    font-size: 12px;
}

QFrame#contentCard {
    background-color: #19212A;
    border: 1px solid #354252;
    border-radius: 8px;
}

QPushButton {
    min-height: 35px;
    padding: 0 13px;
    font-weight: 600;
}

QPushButton#primaryButton {
    background-color: #2F80ED;
    border: 1px solid #2F80ED;
    border-radius: 5px;
    color: #F9FAFB;
    font-weight: 600;
}

QPushButton#primaryButton:pressed { background-color: #2469C5; }

QPushButton#primaryButton:disabled {
    background-color: #27313C;
    border-color: #394654;
    color: #9AA7B3;
}

QPushButton#secondaryButton {
    background-color: #202A36;
    border: 1px solid #2C3643;
    border-radius: 5px;
    color: #cbd4df;
    font-weight: 600;
}

QPushButton#secondaryButton:pressed {
    background-color: #222d39;
    border-color: #526274;
}

QPushButton#tertiaryButton {
    background-color: transparent;
    border: 0;
    color: #7f8d9d;
    min-height: 24px;
    padding: 0 7px;
}

QPushButton#tertiaryButton:pressed {
    background-color: #1d2631;
    color: #d6dee8;
}

QPushButton#dangerButton {
    background-color: #D9534F;
    border: 1px solid #D9534F;
    border-radius: 5px;
    color: #F9FAFB;
    font-weight: 600;
}

QPushButton#dangerButton:pressed { background-color: #8f2229; }

QLineEdit#deviceSearch {
    background-color: #0b1016;
    border: 1px solid #303a47;
    border-radius: 5px;
    color: #edf2f7;
    min-height: 34px;
    padding: 0 10px;
    selection-background-color: #1769aa;
}

QLineEdit#deviceSearch:focus {
    border-color: #378bd1;
    background-color: #0d131a;
}

QLabel#summaryText,
QLabel#connectedSummary,
QLabel#offlineSummary {
    background-color: #19212b;
    border: 1px solid #2c3744;
    border-radius: 11px;
    color: #9caaba;
    font-size: 11px;
    min-height: 22px;
    padding: 0 9px;
}

QLabel#connectedSummary {
    background-color: #12251b;
    border-color: #265b3b;
    color: #65c989;
}

QLabel#offlineSummary {
    background-color: #2a181b;
    border-color: #69343a;
    color: #ff8b83;
}

QTableView#deviceTable,
QTableView#accountsTable {
    alternate-background-color: #0f151c;
    background-color: #0b1016;
    border: 1px solid #28323e;
    border-radius: 5px;
    color: #cbd4df;
    gridline-color: #222b35;
    outline: 0;
    selection-background-color: #173b66;
    selection-color: #f3f7fb;
}

QTableView#deviceTable::item,
QTableView#accountsTable::item {
    border-bottom: 1px solid #1c242e;
    padding: 0 9px;
}

QTableView#accountsTable::item {
    padding: 0 6px;
}

QTableView#deviceTable::item:selected,
QTableView#accountsTable::item:selected {
    background-color: #173b66;
}

QHeaderView::section {
    background-color: #202A36;
    border: 0;
    border-bottom: 1px solid #303a47;
    color: #8492a3;
    font-size: 11px;
    font-weight: 700;
    min-height: 30px;
    padding: 0 9px;
}

QTableCornerButton::section {
    background-color: #151b23;
    border: 0;
    border-bottom: 1px solid #303a47;
}

QWidget#emptyState { background: transparent; }

QLabel#emptyStateIcon { margin-bottom: 5px; }

QLabel#emptyStateTitle {
    color: #cbd4df;
    font-size: 15px;
    font-weight: 600;
}

QLabel#emptyStateDescription {
    color: #6f7d8d;
    font-size: 12px;
}

QLabel#errorBanner {
    background-color: #32191d;
    border: 1px solid #7c3037;
    border-radius: 5px;
    color: #f0a4a9;
    padding: 9px 11px;
}

QFrame#deviceContext {
    background-color: #111820;
    border: 1px solid #293746;
    border-radius: 7px;
}

QLabel#connectionDot {
    color: #f85149;
    font-size: 17px;
}

QLabel#connectionDot[connected="true"] { color: #3fb950; }

QLabel#deviceContextTitle {
    color: #e9eef4;
    font-size: 13px;
    font-weight: 600;
}

QLabel#deviceContextSerial {
    color: #748294;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

QWidget#liveLogPanel {
    background-color: #11161d;
    border-top: 1px solid #27303b;
}

QLabel#panelTitle {
    color: #c8d1dc;
    font-size: 11px;
    font-weight: 700;
}

QPlainTextEdit#liveLogOutput {
    background-color: #080c11;
    border: 1px solid #242d38;
    border-radius: 4px;
    color: #9daaba;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    padding: 6px 8px;
    selection-background-color: #1769aa;
}

QDialog#confirmationDialog,
QDialog#addDeviceDialog,
QDialog#addAccountDialog,
QDialog#inputDialog,
QDialog#transferAccountDialog {
    background-color: #181F27;
    border: 1px solid #2C3643;
    border-radius: 9px;
}

QLabel#dialogSubtitle {
    color: #9AA7B3;
    font-size: 12px;
}

QLabel#dialogFieldLabel {
    color: #9AA7B3;
    font-size: 11px;
    font-weight: 600;
}

QLabel#dialogHint {
    color: #9AA7B3;
    font-size: 12px;
    padding: 3px 0;
}

QLineEdit#dialogInput {
    background-color: #0E141B;
    border: 1px solid #3A4858;
    border-radius: 6px;
    color: #F2F5F7;
    min-height: 39px;
    padding: 0 11px;
    selection-background-color: #2F80ED;
}

QLineEdit#dialogInput:focus {
    border-color: #4A9AF5;
    background-color: #101821;
}

QToolButton#configurationSectionHeader {
    color: #F1F5F9;
    border: 0;
    font-size: 14px;
    font-weight: 700;
    min-height: 30px;
    text-align: left;
}

QCheckBox#configurationSwitch::indicator {
    width: 34px;
    height: 18px;
    border: 1px solid #526171;
    border-radius: 9px;
    background-color: #29333E;
}

QCheckBox#configurationSwitch::indicator:checked {
    border-color: #2F80ED;
    background-color: #2F80ED;
}

QListWidget#dialogDeviceList {
    background-color: #11161C;
    border: 1px solid #2C3643;
    border-radius: 6px;
    color: #F2F5F7;
    outline: 0;
    padding: 5px;
}

QListWidget#dialogDeviceList::item {
    border-radius: 4px;
    min-height: 35px;
    padding: 0 9px;
}

QListWidget#dialogDeviceList::item:selected {
    background-color: #2F80ED;
    color: #F2F5F7;
}

QLabel#dialogTitle {
    color: #f2f5f8;
    font-size: 18px;
    font-weight: 700;
}

QLabel#dialogMessage {
    color: #c8d1dc;
    font-size: 13px;
    margin-top: 5px;
}

QLabel#dialogDetail {
    background-color: #24171a;
    border-left: 3px solid #d6454d;
    color: #d49ca1;
    padding: 9px 10px;
    margin-top: 5px;
}

QMenu {
    background-color: #151b23;
    border: 1px solid #354252;
    padding: 5px;
}

QMenu::item {
    border-radius: 4px;
    padding: 7px 24px 7px 10px;
}

QMenu::item:selected { background-color: #173b66; }

QTabWidget#accountTabs::pane {
    background-color: #181F27;
    border: 1px solid #2C3643;
    border-radius: 5px;
    top: -1px;
}

QTabWidget#accountTabs QTabBar::tab {
    background-color: #151b23;
    border: 1px solid #2C3643;
    border-bottom: 0;
    color: #9AA7B3;
    min-height: 32px;
    padding: 0 13px;
}

QTabWidget#accountTabs QTabBar::tab:selected {
    background-color: #202A36;
    color: #F2F5F7;
}

QToolTip {
    background-color: #202934;
    border: 1px solid #455466;
    color: #e7edf4;
    padding: 5px 7px;
}

QStatusBar {
    background-color: #11161d;
    border-top: 1px solid #27303b;
    color: #718092;
    font-size: 11px;
    padding-left: 7px;
}

QSplitter::handle { background-color: #27303b; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 2px; }

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #34404e;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: transparent;
    height: 9px;
}

QScrollBar::handle:horizontal {
    background: #34404e;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }

/* Sprint 5.15 visual identity. Shared controls inherit this palette. */
QMainWindow,
QWidget#devicesPage,
QWidget#phoneAccountsPage,
QWidget#accountPage,
QWidget#activityLogPage,
QWidget#globalSettingsPage,
QWidget#templatesPage,
QStackedWidget,
QScrollArea,
QScrollArea > QWidget > QWidget,
QAbstractScrollArea::viewport {
    background-color: #18181B;
}

* {
    color: #F9FAFB;
    font-family: "Segoe UI Variable", "Segoe UI";
    font-size: 14px;
}

QLabel:disabled,
QPushButton:disabled,
QToolButton:disabled,
QCheckBox:disabled,
QRadioButton:disabled {
    color: #52525B;
}

QWidget#navigationSidebar,
QToolBar#topToolbar,
QDialog#confirmationDialog,
QDialog#addDeviceDialog,
QDialog#addAccountDialog,
QDialog#inputDialog,
QDialog#transferAccountDialog {
    background-color: #27272A;
    border-color: #3F3F46;
}

QFrame#contentCard,
QFrame#deviceContext,
QLabel#summaryText,
QMenu,
QToolTip {
    background-color: #27272A;
    border-color: #3F3F46;
}

QLabel#pageTitle,
QLabel#dialogTitle,
QLabel#deviceContextTitle,
QLabel#emptyStateTitle,
QLabel#brandLabel {
    color: #F9FAFB;
}

QLabel#pageSubtitle,
QLabel#dialogSubtitle,
QLabel#dialogFieldLabel,
QLabel#dialogHint,
QLabel#brandCaption,
QLabel#emptyStateDescription,
QLabel#deviceContextSerial {
    color: #A1A1AA;
}

QPushButton#primaryButton {
    background-color: #3B82F6;
    border-color: #3B82F6;
    color: #F9FAFB;
}
QPushButton#primaryButton:hover { background-color: #4B8EF7; border-color: #60A5FA; }
QPushButton#primaryButton:pressed { background-color: #2563EB; border-color: #2563EB; }
QPushButton#primaryButton:disabled { background-color: #27272A; border-color: #3F3F46; color: #52525B; }

QPushButton#secondaryButton,
QToolBar#topToolbar QToolButton {
    background-color: #27272A;
    border-color: #3F3F46;
    color: #F9FAFB;
}
QPushButton#secondaryButton:hover,
QToolBar#topToolbar QToolButton:hover { background-color: #3F3F46; border-color: #52525B; }
QPushButton#secondaryButton:pressed,
QToolBar#topToolbar QToolButton:pressed { background-color: #18181B; border-color: #3B82F6; }

QPushButton#dangerButton { background-color: #EF4444; border-color: #EF4444; color: #F9FAFB; }
QPushButton#dangerButton:hover { background-color: #F05252; border-color: #F87171; }
QPushButton#dangerButton:pressed { background-color: #DC2626; border-color: #DC2626; }

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QListWidget#configurationList,
QListWidget#dialogDeviceList {
    background-color: #27272A;
    border: 1px solid #3F3F46;
    border-radius: 6px;
    color: #F9FAFB;
    selection-background-color: #3B82F6;
    selection-color: #F9FAFB;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox { min-height: 35px; padding: 0 10px; }
QPlainTextEdit, QTextEdit { padding: 8px 10px; }

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover { border-color: #52525B; }

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus { border: 1px solid #3B82F6; background-color: #27272A; }

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled { background-color: #18181B; border-color: #27272A; color: #52525B; }

QComboBox QAbstractItemView { background-color: #27272A; border: 1px solid #3F3F46; selection-background-color: #3B82F6; }

QCheckBox,
QRadioButton { color: #F9FAFB; spacing: 8px; }
QCheckBox::indicator,
QRadioButton::indicator { width: 17px; height: 17px; border: 1px solid #52525B; background-color: #27272A; }
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:hover,
QRadioButton::indicator:hover { border-color: #3B82F6; }
QCheckBox::indicator:checked,
QRadioButton::indicator:checked { background-color: #3B82F6; border-color: #3B82F6; }

QCheckBox#configurationSwitch::indicator { width: 36px; height: 20px; border-radius: 10px; background-color: #3F3F46; border-color: #52525B; }
QCheckBox#configurationSwitch::indicator:hover { border-color: #A1A1AA; }
QCheckBox#configurationSwitch::indicator:checked { background-color: #3B82F6; border-color: #60A5FA; }

QTabWidget#accountTabs::pane { background-color: #18181B; border-color: #3F3F46; }
QTabWidget#accountTabs QTabBar::tab { background-color: #18181B; border-color: #3F3F46; color: #A1A1AA; font-weight: 600; }
QTabWidget#accountTabs QTabBar::tab:hover { background-color: #27272A; color: #F9FAFB; }
QTabWidget#accountTabs QTabBar::tab:selected { background-color: #27272A; border-bottom: 3px solid #3B82F6; color: #F9FAFB; }

QTableView#deviceTable,
QTableView#accountsTable { background-color: #18181B; alternate-background-color: #202023; border-color: #3F3F46; color: #F9FAFB; gridline-color: #27272A; selection-background-color: #1D4ED8; }
QTableView#deviceTable::item:hover,
QTableView#accountsTable::item:hover { background-color: #27272A; }
QTableView#deviceTable::item:selected,
QTableView#accountsTable::item:selected { background-color: #1D4ED8; color: #F9FAFB; }
QHeaderView::section { background-color: #27272A; border-color: #3F3F46; color: #A1A1AA; }

QToolButton#configurationSectionHeader { color: #F9FAFB; font-weight: 700; }
QToolButton#configurationSectionHeader:hover { background: transparent; }
QLabel#configurationSectionTitle {
    color: #F9FAFB;
    font-size: 14px;
    font-weight: 700;
    padding: 4px 2px 6px 2px;
}

QPushButton#linkButton {
    background: transparent;
    border: 0;
    color: #60A5FA;
    font-weight: 600;
    min-height: 28px;
    padding: 0 4px;
    text-align: left;
}
QPushButton#linkButton:hover { color: #93C5FD; text-decoration: underline; }
QPushButton#linkButton:pressed { color: #3B82F6; }

QLabel#mutedLabel { color: #A1A1AA; font-size: 12px; }

QLabel#connectionDot[connected="true"] { color: #22C55E; }
QLabel#connectionDot { color: #EF4444; }
QLabel#connectedSummary { color: #22C55E; border-color: #166534; background-color: #1A2E21; }
QLabel#offlineSummary { color: #EF4444; border-color: #7F1D1D; background-color: #321C1C; }
QLabel#errorBanner { color: #FCA5A5; border-color: #EF4444; background-color: #321C1C; }
QLabel[status="warning"] { color: #F59E0B; }

QWidget#liveLogPanel,
QPlainTextEdit#liveLogOutput,
QStatusBar { background-color: #18181B; border-color: #3F3F46; }
QPlainTextEdit#liveLogOutput { color: #A1A1AA; }
