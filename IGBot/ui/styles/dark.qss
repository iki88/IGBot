* {
    color: #F2F5F7;
    font-family: "Segoe UI";
    font-size: 13px;
}

QMainWindow,
QWidget#devicesPage,
QWidget#phoneAccountsPage,
QStackedWidget {
    background-color: #11161C;
}

QWidget#navigationSidebar {
    background-color: #181F27;
    border-right: 1px solid #2C3643;
}

QLabel#brandLabel {
    color: #f2f5f8;
    font-size: 21px;
    font-weight: 700;
    padding: 0 7px;
}

QLabel#brandCaption {
    color: #9AA7B3;
    font-size: 11px;
    font-weight: 500;
    padding: 0 7px;
}

QLabel#navigationSection {
    color: #687585;
    font-size: 10px;
    font-weight: 700;
    padding: 0 8px;
}

QListWidget#navigationList {
    background: transparent;
    border: 0;
    outline: 0;
}

QListWidget#navigationList::item {
    color: #9ba8b7;
    border-radius: 6px;
    min-height: 36px;
    padding: 0 10px;
    margin-bottom: 3px;
}

QListWidget#navigationList::item:selected {
    background-color: #173b66;
    color: #ffffff;
}

QToolBar#topToolbar {
    background-color: #181F27;
    border: 0;
    border-bottom: 1px solid #27303b;
    padding: 7px 14px;
    spacing: 8px;
}

QToolBar#topToolbar QToolButton {
    background-color: transparent;
    border: 1px solid #303a47;
    border-radius: 5px;
    color: #c8d1dc;
    min-height: 28px;
    padding: 0 10px;
}

QToolBar#topToolbar QToolButton:pressed {
    background-color: #202b37;
    border-color: #526274;
}

QLabel#toolbarTitle {
    color: #e8edf3;
    font-size: 13px;
    font-weight: 600;
}

QWidget#pageHeader { background: transparent; }

QLabel#pageTitle {
    color: #f2f5f8;
    font-size: 22px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #788697;
    font-size: 12px;
}

QFrame#contentCard {
    background-color: #181F27;
    border: 1px solid #2C3643;
    border-radius: 8px;
}

QPushButton {
    min-height: 34px;
    padding: 0 12px;
}

QPushButton#primaryButton {
    background-color: #2F80ED;
    border: 1px solid #2F80ED;
    border-radius: 5px;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryButton:pressed { background-color: #2469C5; }

QPushButton#primaryButton:disabled {
    background-color: #27313C;
    border-color: #394654;
    color: #9AA7B3;
}

QPushButton#secondaryButton {
    background-color: #202A36;
    border: 1px solid #2C3643;
    border-radius: 5px;
    color: #cbd4df;
    font-weight: 600;
}

QPushButton#secondaryButton:pressed {
    background-color: #222d39;
    border-color: #526274;
}

QPushButton#tertiaryButton {
    background-color: transparent;
    border: 0;
    color: #7f8d9d;
    min-height: 24px;
    padding: 0 7px;
}

QPushButton#tertiaryButton:pressed {
    background-color: #1d2631;
    color: #d6dee8;
}

QPushButton#dangerButton {
    background-color: #D9534F;
    border: 1px solid #D9534F;
    border-radius: 5px;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#dangerButton:pressed { background-color: #8f2229; }

QLineEdit#deviceSearch {
    background-color: #0b1016;
    border: 1px solid #303a47;
    border-radius: 5px;
    color: #edf2f7;
    min-height: 34px;
    padding: 0 10px;
    selection-background-color: #1769aa;
}

QLineEdit#deviceSearch:focus {
    border-color: #378bd1;
    background-color: #0d131a;
}

QLabel#summaryText,
QLabel#connectedSummary,
QLabel#offlineSummary {
    background-color: #19212b;
    border: 1px solid #2c3744;
    border-radius: 11px;
    color: #9caaba;
    font-size: 11px;
    min-height: 22px;
    padding: 0 9px;
}

QLabel#connectedSummary {
    background-color: #12251b;
    border-color: #265b3b;
    color: #65c989;
}

QLabel#offlineSummary {
    background-color: #2a181b;
    border-color: #69343a;
    color: #ff8b83;
}

QTableView#deviceTable,
QTableView#accountsTable {
    alternate-background-color: #0f151c;
    background-color: #0b1016;
    border: 1px solid #28323e;
    border-radius: 5px;
    color: #cbd4df;
    gridline-color: #222b35;
    outline: 0;
    selection-background-color: #173b66;
    selection-color: #f3f7fb;
}

QTableView#deviceTable::item,
QTableView#accountsTable::item {
    border-bottom: 1px solid #1c242e;
    padding: 0 9px;
}

QTableView#deviceTable::item:selected,
QTableView#accountsTable::item:selected {
    background-color: #173b66;
}

QHeaderView::section {
    background-color: #202A36;
    border: 0;
    border-bottom: 1px solid #303a47;
    color: #8492a3;
    font-size: 11px;
    font-weight: 700;
    min-height: 30px;
    padding: 0 9px;
}

QTableCornerButton::section {
    background-color: #151b23;
    border: 0;
    border-bottom: 1px solid #303a47;
}

QWidget#emptyState { background: transparent; }

QLabel#emptyStateIcon { margin-bottom: 5px; }

QLabel#emptyStateTitle {
    color: #cbd4df;
    font-size: 15px;
    font-weight: 600;
}

QLabel#emptyStateDescription {
    color: #6f7d8d;
    font-size: 12px;
}

QLabel#errorBanner {
    background-color: #32191d;
    border: 1px solid #7c3037;
    border-radius: 5px;
    color: #f0a4a9;
    padding: 9px 11px;
}

QFrame#deviceContext {
    background-color: #111820;
    border: 1px solid #293746;
    border-radius: 7px;
}

QLabel#connectionDot {
    color: #f85149;
    font-size: 17px;
}

QLabel#connectionDot[connected="true"] { color: #3fb950; }

QLabel#deviceContextTitle {
    color: #e9eef4;
    font-size: 13px;
    font-weight: 600;
}

QLabel#deviceContextSerial {
    color: #748294;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

QWidget#liveLogPanel {
    background-color: #11161d;
    border-top: 1px solid #27303b;
}

QLabel#panelTitle {
    color: #c8d1dc;
    font-size: 11px;
    font-weight: 700;
}

QPlainTextEdit#liveLogOutput {
    background-color: #080c11;
    border: 1px solid #242d38;
    border-radius: 4px;
    color: #9daaba;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    padding: 6px 8px;
    selection-background-color: #1769aa;
}

QDialog#confirmationDialog,
QDialog#addDeviceDialog,
QDialog#inputDialog,
QDialog#transferAccountDialog {
    background-color: #181F27;
    border: 1px solid #2C3643;
    border-radius: 9px;
}

QLabel#dialogSubtitle {
    color: #9AA7B3;
    font-size: 12px;
}

QLabel#dialogFieldLabel {
    color: #9AA7B3;
    font-size: 11px;
    font-weight: 600;
}

QLabel#dialogHint {
    color: #9AA7B3;
    font-size: 12px;
    padding: 3px 0;
}

QLineEdit#dialogInput {
    background-color: #11161C;
    border: 1px solid #2C3643;
    border-radius: 6px;
    color: #F2F5F7;
    min-height: 38px;
    padding: 0 11px;
    selection-background-color: #2F80ED;
}

QLineEdit#dialogInput:focus { border-color: #2F80ED; }

QListWidget#dialogDeviceList {
    background-color: #11161C;
    border: 1px solid #2C3643;
    border-radius: 6px;
    color: #F2F5F7;
    outline: 0;
    padding: 5px;
}

QListWidget#dialogDeviceList::item {
    border-radius: 4px;
    min-height: 35px;
    padding: 0 9px;
}

QListWidget#dialogDeviceList::item:selected {
    background-color: #2F80ED;
    color: #F2F5F7;
}

QLabel#dialogTitle {
    color: #f2f5f8;
    font-size: 18px;
    font-weight: 700;
}

QLabel#dialogMessage {
    color: #c8d1dc;
    font-size: 13px;
    margin-top: 5px;
}

QLabel#dialogDetail {
    background-color: #24171a;
    border-left: 3px solid #d6454d;
    color: #d49ca1;
    padding: 9px 10px;
    margin-top: 5px;
}

QMenu {
    background-color: #151b23;
    border: 1px solid #354252;
    padding: 5px;
}

QMenu::item {
    border-radius: 4px;
    padding: 7px 24px 7px 10px;
}

QMenu::item:selected { background-color: #173b66; }

QToolTip {
    background-color: #202934;
    border: 1px solid #455466;
    color: #e7edf4;
    padding: 5px 7px;
}

QStatusBar {
    background-color: #11161d;
    border-top: 1px solid #27303b;
    color: #718092;
    font-size: 11px;
    padding-left: 7px;
}

QSplitter::handle { background-color: #27303b; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 2px; }

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #34404e;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: transparent;
    height: 9px;
}

QScrollBar::handle:horizontal {
    background: #34404e;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
